{
  "name": "angular-17",
  "version": "0.0.0",
  "main": "dist",
  "files": [
    "dist"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build components",
    "pack-components": "pnpm export:manifest && pnpm --dir dist/components pack",
    "package": "pnpm build && pnpm pack-components",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "export:manifest": "pnpm workspace export:manifest packages/angular-17/projects/components packages/angular-17/dist/components",
    "workspace": "pnpm --workspace-root"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@scania/tegel": "file:../../core-tarball/scania-tegel-1.63.1.tgz",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
